# Telegram（必填，--dry-run 时可不填）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 调度：北京时间每天 00:00、04:00、08:00、12:00、16:00、20:00
REPORT_TIMEZONE=Asia/Shanghai
REPORT_HOURS=0,4,8,12,16,20
SCHEDULE_GRACE_MINUTES=10

# 市场范围与榜单
QUOTE_ASSETS=USDT
TOP_N=5
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3

# 运行状态；用于防止同一时点重复推送
STATE_FILE=state/scheduler.json

# 可选：Telegram 论坛群组的话题 ID
TELEGRAM_MESSAGE_THREAD_ID=
