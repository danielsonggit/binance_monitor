# 启动命令：docker compose --env-file .env.v2 -p binance-radar-v2 -f compose.v2.yaml up -d --build

# PostgreSQL。部署前必须替换为较长的 URL-safe 随机密码；该文件复制为 .env.v2 后不会被 Git 跟踪。
POSTGRES_DB=binance_radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_MAX_CONNS=10

# Compose 会根据上面三个 POSTGRES 变量生成容器内 DATABASE_URL。
# 只在宿主机直接运行二进制时自行设置 DATABASE_URL。
# PostgreSQL 仅发布到宿主机 loopback，供 jmk user-systemd V2 服务访问。
V2_POSTGRES_PORT=54329

# V2 市场范围与时间
APP_TIMEZONE=Asia/Shanghai
QUOTE_ASSETS=USDT,USDC
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BINANCE_WS_BASE_URL=wss://fstream.binance.com
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
# Binance USD-M 通用请求权重上限为 2400/min。默认保留 25% 余量，
# burst 至少为 10，以允许单次 limit=1500 的 K 线请求。
BINANCE_REQUEST_WEIGHT_PER_MINUTE=1800
BINANCE_REQUEST_WEIGHT_BURST=50
UNIVERSE_SYNC_INTERVAL_MINUTES=60
UNIVERSE_MINIMUM_RATIO_PERCENT=80
UNIVERSE_MISSING_CONFIRMATIONS=2
WS_STALE_AFTER_SECONDS=30
WS_ROTATE_AFTER_MINUTES=1410
WS_RECONNECT_WAIT_SECONDS=5
# 15m/1h/4h 热计算与重启预热至少保留 6 小时。
MARKET_WINDOW_RETENTION_MINUTES=360
# 超过该时间未更新的 ticker 不得写入新快照；必须小于 300 秒。
SNAPSHOT_MAX_EVENT_AGE_SECONDS=90
# worker 全局断流健康阈值。影子样本最低为 89.1%；低活跃 TradFi 缺失仍逐项入库，
# 但整体覆盖达到 85% 不判定采集进程故障。
SNAPSHOT_MINIMUM_RATIO_PERCENT=85
# 至少覆盖完整 24h 指标并保留边界余量。
BACKFILL_LOOKBACK_HOURS=30
# 按 symbol 并发；所有 REST 请求仍共享上面的全局权重限流器。
BACKFILL_CONCURRENCY=8

# 多周期收益率质量门禁。当前价和基准价最多允许偏离目标 5 分钟；
# 低于 75 分的 5 分钟快照不参与计算，最近 60 分钟零成交量视为不可交易。
FEATURE_CURRENT_MAX_AGE_SECONDS=300
FEATURE_BASELINE_MAX_OFFSET_SECONDS=300
FEATURE_MINIMUM_QUALITY_SCORE=75
# worker 灾难性缺数健康阈值。15m 完成 K 线使 +10 分钟窗口正常覆盖约 61%–64%；
# 这里只判断流水线是否失去法定人数，不会放宽 5 分钟偏移/质量门禁，也不会让无效值进入榜单。
FEATURE_MINIMUM_COVERAGE_PERCENT=60
# 在自然 5 分钟边界后等待快照落库，再执行回补和特征计算。
FEATURE_CALCULATION_DELAY_SECONDS=5
# 每个板块、每个周期保存的涨幅榜数量。
RANKING_TOP_N=5

# jmk user-systemd 运行器会强制改为 http://127.0.0.1:7890。
# docker-app profile 使用 host network 访问同一地址。不要填写 7891。
HTTP_PROXY_URL=http://host.docker.internal:7890

# API 容器监听地址，以及宿主机发布地址/端口。
# 正式部署时可把 V2_WEB_BIND_ADDRESS 改为 jmk 的 Tailscale IP。
WEB_LISTEN_ADDR=0.0.0.0:8080
V2_WEB_BIND_ADDRESS=127.0.0.1
V2_WEB_PORT=8080
# user-systemd 影子 API 默认单独使用 18080，且仅监听 loopback。
V2_SYSTEMD_API_LISTEN_ADDR=127.0.0.1:18080

SHUTDOWN_TIMEOUT_SECONDS=15
WORKER_HEARTBEAT_SECONDS=15

# MHR-6 reporter 独立进程使用；worker 和 api 不会发送 Telegram。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
REPORT_HOURS=0,4,8,12,16,20
REPORT_GRACE_MINUTES=10
REPORTER_POLL_SECONDS=15
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_RETRY_BASE_SECONDS=30

# 独立健康 watchdog。默认 dry-run，不会调用 Telegram；告警接收人与市场报表分开配置。
WATCHDOG_API_BASE_URL=http://127.0.0.1:18080
WATCHDOG_POLL_SECONDS=60
WATCHDOG_FAILURE_THRESHOLD=3
WATCHDOG_RECOVERY_THRESHOLD=2
WATCHDOG_REQUEST_TIMEOUT_SECONDS=5
WATCHDOG_HEARTBEAT_MAX_AGE_SECONDS=90
WATCHDOG_MARKET_MAX_AGE_SECONDS=120
WATCHDOG_DATA_MAX_AGE_SECONDS=600
WATCHDOG_STATE_FILE=state/watchdog.json
WATCHDOG_DRY_RUN=true
WATCHDOG_TELEGRAM_BOT_TOKEN=
WATCHDOG_TELEGRAM_CHAT_IDS=
WATCHDOG_TELEGRAM_MESSAGE_THREAD_ID=
