# 启动命令：docker compose --env-file .env.v2 -p binance-radar-v2 -f compose.v2.yaml up -d --build

# PostgreSQL。部署前必须替换为较长的 URL-safe 随机密码；该文件复制为 .env.v2 后不会被 Git 跟踪。
POSTGRES_DB=binance_radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_MAX_CONNS=10

# Compose 会根据上面三个 POSTGRES 变量生成容器内 DATABASE_URL。
# 只在宿主机直接运行二进制时自行设置 DATABASE_URL。

# V2 市场范围与时间
APP_TIMEZONE=Asia/Shanghai
QUOTE_ASSETS=USDT,USDC
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BINANCE_WS_BASE_URL=wss://fstream.binance.com
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
# Binance USD-M 通用请求权重上限为 2400/min。默认保留 25% 余量，
# burst 至少为 10，以允许单次 limit=1500 的 K 线请求。
BINANCE_REQUEST_WEIGHT_PER_MINUTE=1800
BINANCE_REQUEST_WEIGHT_BURST=50
UNIVERSE_SYNC_INTERVAL_MINUTES=60
UNIVERSE_MINIMUM_RATIO_PERCENT=80
UNIVERSE_MISSING_CONFIRMATIONS=2
WS_STALE_AFTER_SECONDS=30
WS_ROTATE_AFTER_MINUTES=1410
WS_RECONNECT_WAIT_SECONDS=5
MARKET_WINDOW_RETENTION_MINUTES=120
# 超过该时间未更新的 ticker 不得写入新快照；必须小于 300 秒。
SNAPSHOT_MAX_EVENT_AGE_SECONDS=90
# 至少覆盖完整 24h 指标并保留边界余量。
BACKFILL_LOOKBACK_HOURS=30
# 按 symbol 并发；所有 REST 请求仍共享上面的全局权重限流器。
BACKFILL_CONCURRENCY=8

# jmk Docker 中通过宿主机 Clash 7890 出网。不要填写 7891。
HTTP_PROXY_URL=http://host.docker.internal:7890

# API 容器监听地址，以及宿主机发布地址/端口。
# 正式部署时可把 V2_WEB_BIND_ADDRESS 改为 jmk 的 Tailscale IP。
WEB_LISTEN_ADDR=0.0.0.0:8080
V2_WEB_BIND_ADDRESS=127.0.0.1
V2_WEB_PORT=8080

SHUTDOWN_TIMEOUT_SECONDS=15
WORKER_HEARTBEAT_SECONDS=15

# Phase 3 启用。当前 Phase 1 worker 不读取或发送 Telegram。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
