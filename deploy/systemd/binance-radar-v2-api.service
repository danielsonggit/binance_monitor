[Unit]
Description=Binance Market Radar V2 read-only API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/daniel/services/binance-radar-v2
Environment=BINANCE_RADAR_V2_DIR=/home/daniel/services/binance-radar-v2
ExecStart=/home/daniel/services/binance-radar-v2/run-v2 api
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=512M
CPUQuota=100%
TasksMax=512
StandardOutput=journal
StandardError=journal
SyslogIdentifier=binance-radar-v2-api

[Install]
WantedBy=default.target
