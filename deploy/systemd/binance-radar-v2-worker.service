[Unit]
Description=Binance Market Radar V2 shadow worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/daniel/services/binance-radar-v2
Environment=BINANCE_RADAR_V2_DIR=/home/daniel/services/binance-radar-v2
ExecStart=/home/daniel/services/binance-radar-v2/run-v2 worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=2G
CPUQuota=300%
TasksMax=2048
StandardOutput=journal
StandardError=journal
SyslogIdentifier=binance-radar-v2-worker

[Install]
WantedBy=default.target
